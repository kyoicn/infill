# 数据目录（catalog.yaml.example 保留）
/data/*
!/data/catalog.yaml.example

# intake 临时文件与目录备份（产品录入功能产生）
data/intake_tmp/
data/catalog.yaml.bak.*

# 后端
backend/__pycache__/
backend/app/__pycache__/
backend/app/**/__pycache__/
backend/data.db
backend/static/
*.pyc

# 前端
frontend/node_modules/
frontend/dist/

# 部署产物
/release/
release/extension/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# AI 工具本地配置
.claude/
.codex/

# 本地 LLM provider 配置（含 API key，绝不进 git）
.env

# QA / 多agent工作流
.qa-dev-server.pid
.qa-dev-server.log
docs/issues-attachments/
docs/gorilla/*/screenshots/
docs/qa-artifacts/
.playwright-mcp/
