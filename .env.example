# intake (产品录入) — LLM Vision Provider 配置
#
# 使用方式：
#   1. 选当前激活的 provider（下方 LLM_PROVIDER 改一行即可切换）
#   2. 在对应 <PROVIDER>_API_KEY 填 key；多个 provider 的 key 可以同时常驻
#   3. 想自定义 base_url / model 就改 <PROVIDER>_BASE_URL / <PROVIDER>_MODEL，
#      留空则用 backend/app/services/intake_llm.py:PROVIDERS 注册表里的默认值
#
# 支持的 LLM_PROVIDER 值：qwen / deepseek / doubao / siliconflow / kimi / openai

LLM_PROVIDER=qwen

# Qwen (DashScope) — 阿里云，国内直连，OCR 强项 + 价格友好
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-ocr

# DeepSeek — 公网 API 实测不支持 vision，仅留作历史兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Doubao (火山方舟) — 字节跳动
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-1-5-vision-pro-32k-250115

# SiliconFlow (硅基流动) — 多家模型聚合
# 注意：DeepSeek-VL2 超过 2 张图会自动降采样到 384×384，慎选
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k-vision-preview

# OpenAI（海外）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
