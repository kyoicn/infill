# 产品目录示例 — 系统唯一数据源
# 复制为 catalog.yaml 后修改，在网页上点击"重新加载目录"即可生效
#
# v0.3.0：SKU-keyed
# - 每个组件/打印盘/产品都有一个永久不变的"编号"（SKU）作为稳定标识
#   组件 C-NNNN / 打印盘 P-NNNN / 产品 PR-NNNN
# - 名称（名称 / 盘号）可改，不会影响引用关系
# - 引用走"组件编号"，不再用名字
# - 旧版本（无"编号"）的 catalog.yaml 在启动时会自动 backfill SKU
#   也可手动调 POST /api/catalog/migrate-to-sku 触发

组件:
  - 编号: C-0001
    名称: 组件A
    描述: 底座部件
    可选颜色: [白色, 红色, 黑色]
  - 编号: C-0002
    名称: 组件B
    描述: 顶盖部件
    可选颜色: [白色, 黑色]
  - 编号: C-0003
    名称: 组件C
    描述: 通用配件

打印盘:
  - 编号: P-0001
    盘号: 1号盘
    组件编号: C-0001
    数量: 10
    耗时分钟: 120
  - 编号: P-0002
    盘号: 2号盘
    组件编号: C-0002
    数量: 8
    耗时分钟: 90
  - 编号: P-0003
    盘号: 3号盘
    组件编号: C-0003
    数量: 20
    耗时分钟: 60

产品:
  - 编号: PR-0001
    名称: 产品A
    描述: 白+黑经典款
    BOM:
      - 组件编号: C-0001
        颜色: 白色
        数量: 1
      - 组件编号: C-0002
        颜色: 黑色
        数量: 1
      - 组件编号: C-0003
        数量: 2
  - 编号: PR-0002
    名称: 产品B
    描述: 红+白限定款
    BOM:
      - 组件编号: C-0001
        颜色: 红色
        数量: 1
      - 组件编号: C-0002
        颜色: 白色
        数量: 1
      - 组件编号: C-0003
        数量: 2
